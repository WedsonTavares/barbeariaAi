# ===== Banco (Supabase) =====
# Runtime: role RESTRITA app_runtime (sem BYPASSRLS) + pooler (transaction mode)
DATABASE_URL="postgresql://app_runtime:SENHA@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Migrations: role DONO + conexão direta (porta 5432)
DIRECT_URL="postgresql://postgres:SENHA@HOST:5432/postgres?sslmode=require"

# ===== Clerk =====
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# ===== Supabase (Storage / Realtime) =====
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # só servidor/worker

# ===== App =====
NEXT_PUBLIC_ROOT_DOMAIN="seudominio.com.br"   # subdomínio = tenant
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Worker (VPS) =====
REDIS_URL="redis://:SENHA@127.0.0.1:6379"

# ===== Agente de IA (WhatsApp, opcional — ver docs/N8N-AGENTE-IA.md) =====
# O agente roda no n8n; a OpenAI é chamada por lá, não pela Vercel. Aqui só precisa
# do segredo que protege os endpoints-ferramenta (/api/agent/*). Sem ele → 401.
AGENT_API_SECRET="string-aleatoria-longa"
