# Copie para .env.local (Next) e preencha. NUNCA comite o arquivo preenchido —
# .env, .env.test e .env*.local estão no .gitignore de propósito.
#
# Para montar outra máquina: os VALORES de produção estão no painel da Vercel
# (Project Settings → Environment Variables). Este arquivo documenta QUAIS
# variáveis existem e para que servem — os segredos vêm de lá, não do git.

# ===== Banco (Supabase) =====
# Runtime: role RESTRITA app_runtime (sem BYPASSRLS) + pooler (transaction mode)
DATABASE_URL="postgresql://app_runtime:SENHA@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Migrations: role DONO + conexão direta (porta 5432)
DIRECT_URL="postgresql://postgres:SENHA@HOST:5432/postgres?sslmode=require"

# ===== Clerk =====
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/admin"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/admin"

# ===== Supabase (Storage / Realtime) =====
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # só servidor/worker

# ===== App =====
# O subdomínio identifica o tenant: {slug}.{NEXT_PUBLIC_ROOT_DOMAIN}. Toda rota
# /api/agent/* resolve o tenant pelo host — trocar isto redireciona o SaaS inteiro.
NEXT_PUBLIC_ROOT_DOMAIN="seudominio.com.br"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PRIMARY_TENANT_SLUG="barbearia"

# ===== Worker (VPS) =====
REDIS_URL="redis://:SENHA@127.0.0.1:6379"

# ===== Agente de IA (WhatsApp) =====
# O agente vive no n8n; as rotas /api/agent/* são as "ferramentas" que ele chama.
# Este segredo protege TODAS elas (header x-barbearia-ai-secret ou ?token=). Sem ele → 401.
# O mesmo valor precisa estar gravado nos nós HTTP dos workflows do n8n.
AGENT_API_SECRET="string-aleatoria-longa"

# ===== Evolution API (WhatsApp) =====
# Cliente server-only, atrás de um nginx que exige o header configurado em EVOLUTION_PROXY_HEADER.
# Usado por apps/web/src/lib/evolution.ts: QR code, estado da conexão e envio.
# A instância é POR TENANT (TenantSettings.evolutionInstance, com fallback no slug)
# — nunca uma instância global, é o que isola o WhatsApp de cada empresa.
EVOLUTION_API_URL="https://evo.seudominio.com.br"
EVOLUTION_API_KEY="chave-do-evolution"
EVOLUTION_PROXY_SECRET="segredo-exigido-pelo-nginx"

# ===== n8n =====
# Webhook do agente principal. Se definido, /api/whatsapp/inbound repassa a
# mensagem para o n8n (modo híbrido: o cérebro é o workflow). Se ficar vazio, o
# fallback é o bot nativo em packages/core/src/services/bot-service.ts.
N8N_AGENT_WEBHOOK_URL="https://n8n.seudominio.com.br/webhook/barbearia-ai-agente"
# Usado só pelo worker (apps/worker/src/n8n.ts), para disparos agendados.
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# ===== OpenAI (só o bot nativo) =====
# Fallback usado quando N8N_AGENT_WEBHOOK_URL não está definido. Com o n8n no ar,
# a OpenAI é chamada por lá e estas duas podem ficar vazias.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
