    {
      "parameters": {
        "jsCode": "// Extrai dados do payload do seu provedor de WhatsApp (Evolution/Z-API/WPPConnect).\n// Ajuste o 'else' se o seu for diferente. Detecta grupo e mensagens da própria equipe (fromMe).\nconst body = $input.item.json.body ?? $input.item.json;\nlet phone = '', message = '', fromMe = false, isGroup = false, senderName = '';\nif (body.phone && body.text) { // Z-API\n  phone = body.phone;\n  message = (body.text && body.text.message) || body.text || '';\n  fromMe = body.fromMe === true;\n  isGroup = body.isGroup === true;\n  senderName = body.senderName || body.chatName || '';\n} else if (body.data && body.data.key) { // Evolution API\n  const jid = String(body.data.key.remoteJid || '');\n  isGroup = jid.endsWith('@g.us');\n  phone = jid.replace('@s.whatsapp.net', '').replace('@g.us', '');\n  message = (body.data.message && (body.data.message.conversation || (body.data.message.extendedTextMessage && body.data.message.extendedTextMessage.text))) || '';\n  fromMe = body.data.key.fromMe === true;\n  senderName = body.data.pushName || '';\n} else if (body.from) { // WPPConnect\n  isGroup = String(body.from).endsWith('@g.us');\n  phone = String(body.from).replace('@c.us', '').replace('@g.us', '');\n  message = body.body || '';\n  fromMe = body.fromMe === true;\n  senderName = body.notifyName || body.sender?.pushname || '';\n} else {\n  phone = body.phone || body.from || '';\n  message = body.message || body.text || body.body || '';\n}\n// Detecta origem/campanha a partir do texto (ajuste as palavras-chave conforme suas campanhas).\nconst low = String(message).toLowerCase();\nlet source = 'WHATSAPP';\nif (low.includes('instagram') || low.includes('insta')) source = 'INSTAGRAM';\nelse if (low.includes('facebook') || low.includes('face')) source = 'FACEBOOK';\nelse if (low.includes('google')) source = 'GOOGLE';\nelse if (low.includes('indic')) source = 'INDICATION';\nreturn [{ json: { phone: String(phone).replace(/\\D/g, ''), message: String(message).trim(), fromMe, isGroup, senderName, source } }];"
      },
