{
  "name": "diny-saas",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @diny/core db:generate",
    "db:migrate": "pnpm --filter @diny/core db:migrate",
    "db:deploy": "pnpm --filter @diny/core db:deploy",
    "db:rls": "pnpm --filter @diny/core db:rls",
    "db:seed": "pnpm --filter @diny/core db:seed",
    "worker": "pnpm --filter @diny/worker start"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.11.1"
    }
  }
}
