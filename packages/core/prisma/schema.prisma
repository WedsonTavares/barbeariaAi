// Barbearia AI — plataforma multi-tenant para agenda de serviços.
// Tudo isolado por tenantId; RLS aplicado via prisma/rls.sql.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  STAFF
}

enum SiteMode {
  SITE_BUILDER
  EXTERNAL_SITE
  CUSTOM_DOMAIN
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  GOOGLE
  INDICATION
  WHATSAPP
  WEBSITE
  PAID_ADS
  PARTNER
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum ServiceCategory {
  HAIR
  BEARD
  NAILS
  BROWS
  AESTHETICS
  TATTOO
  MASSAGE
  OTHER
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LocationMode {
  SALON
  CUSTOMER_ADDRESS
  ONLINE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  ARRIVED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELED
}

enum CommissionType {
  NONE
  FIXED
  PERCENTAGE
}

enum CommissionStatus {
  PENDING
  SETTLED
  CANCELED
}

enum CalendarProvider {
  /// OAuth por empresa: cada uma autoriza com a conta Google dela e o token
  /// fica cifrado nesta tabela.
  GOOGLE
  /// Conta de serviço da plataforma: a empresa só compartilha a agenda dela com
  /// o e-mail da conta. Não expira e dispensa a verificação do Google — em
  /// troca, a credencial deixa de ser fronteira entre empresas e o isolamento
  /// passa a ser o `calendarId`. Por isso ele é OBRIGATÓRIO neste provider.
  GOOGLE_SERVICE_ACCOUNT
}

enum CalendarConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WaitlistStatus {
  ACTIVE
  CONTACTED
  BOOKED
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentKind {
  APPOINTMENT
  PRODUCT
  REFUND
}

enum ExpenseCategory {
  COMMISSION
  PRODUCTS
  RENT
  UTILITIES
  MARKETING
  SALARY
  OTHER
}

enum AppointmentReminderType {
  APPOINTMENT_24H
  APPOINTMENT_2H
  APPOINTMENT_30M
  FOLLOW_UP_24H
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELED
}

enum NotificationType {
  NEW_WHATSAPP_MESSAGE
  NEW_LEAD
  APPOINTMENT_CREATED
  APPOINTMENT_STARTING_SOON
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCEL_REQUESTED
  APPOINTMENT_NO_SHOW
  /// Avaliação pós-atendimento abaixo do corte: escalado pra equipe em vez do link público.
  POST_SERVICE_LOW_RATING
  PAYMENT_PENDING
  GOOGLE_CALENDAR_SYNC_FAILED
  INTEGRATION_ERROR
}

/// Estágio do lead na SUA prospecção comercial (não confundir com o funil do
/// cliente, que é `ConversationStage` e vive dentro de cada loja).
enum ProspectStage {
  NOVO
  CONTATADO
  RESPONDEU
  DEMO
  PROPOSTA
  GANHO
  PERDIDO
}

/// Por onde o contato aconteceu. Serve para descobrir qual canal abre porta —
/// se ligação converte 3x mais que WhatsApp, muda como você trabalha o dia.
enum ProspectCanal {
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  PRESENCIAL
  OUTRO
}

/// Por que o lead foi perdido. Enum e não texto livre de propósito: é isto que
/// vira o gráfico de "por que estou perdendo vendas", e texto livre não agrupa.
enum ProspectMotivoPerda {
  SEM_INTERESSE
  JA_TEM_FORNECEDOR
  SEM_ORCAMENTO
  NAO_VE_NECESSIDADE
  NAO_RESPONDEU
  CONTATO_INVALIDO
  FORA_DO_PERFIL
  MOMENTO_INADEQUADO
  PRECO
  OUTRO
}

/// Cada toque no lead: ligação, mensagem, reunião. É o histórico que responde
/// "o que eu já falei com essa pessoa" antes de ligar de novo.
model ProspectInteraction {
  id        String        @id @default(uuid())
  leadId    String
  lead      ProspectLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  canal     ProspectCanal
  /// O que aconteceu, em uma linha. É o que aparece resumido na lista.
  resumo    String
  /// Estágio para o qual o lead foi movido NESTE toque, se houve mudança.
  /// Guardar aqui é o que permite calcular conversão real por etapa depois.
  paraStage ProspectStage?
  criadoEm  DateTime      @default(now())

  @@index([leadId, criadoEm])
}

/// Empresa prospectada — barbearia ou salão que VOCÊ quer vender.
///
/// É tabela de PLATAFORMA, como `Tenant`: não tem `tenantId` e não entra na RLS
/// por tenant. O motivo é simples: estes leads são seus, não de uma loja. Se
/// morassem no funil do `/admin` precisariam pertencer a algum tenant, e não
/// pertencem a nenhum — seriam clientes de um cliente, o que não existe aqui.
model ProspectLead {
  id         String   @id @default(uuid())
  /// Id do Google Places. É a chave de deduplicação: reimportar a mesma região
  /// atualiza os dados públicos sem apagar o que você anotou.
  placeId    String   @unique
  nome       String
  nicho      String
  telefone   String?
  site       String?
  maps       String?
  endereco   String?
  nota       Decimal? @db.Decimal(2, 1)
  avaliacoes Int      @default(0)
  /// Score do buscador na hora da importação. Guardado para você comparar depois
  /// o que ele previu com o que de fato converteu.
  score      Int      @default(0)
  motivos    String[] @default([])

  stage       ProspectStage @default(NOVO)
  contatadoEm DateTime?
  observacao  String?

  /// A próxima coisa a fazer e QUANDO. Lead ativo sem isso é lead que some do
  /// processo — a tela avisa quando está vencida ou em branco.
  proximaAcao   String?
  proximaAcaoEm DateTime?

  /// Só preenchido quando o estágio vira PERDIDO. Alimenta o gráfico de perdas.
  motivoPerda ProspectMotivoPerda?

  interacoes ProspectInteraction[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([stage])
  @@index([nicho])
  @@index([proximaAcaoEm])
}

model Tenant {
  id           String   @id @default(uuid())
  clerkOrgId   String   @unique
  slug         String   @unique
  name         String
  customDomain String?  @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // ─── Plataforma / Super Admin ────────────────────────────────────────────
  // Estes campos são da PLATAFORMA sobre a loja, não dados operacionais DELA.
  // Ficam aqui de propósito: `Tenant` é o único ponto de bypass de RLS
  // sancionado (CLAUDE.md, regra 10). Criar tabela nova para isto obrigaria
  // ou uma segunda exceção de RLS, ou ler tenant a tenant dentro de
  // `withTenant` só para montar uma lista — os dois piores que uma coluna aqui.
  // O dono da loja NUNCA vê nem edita nada disto; só /super-admin lê e escreve.

  /// Nome do plano, texto livre ("Mensal", "Anual", "Cortesia").
  plan             String?
  /// Valor combinado da mensalidade. Só registro — não há cobrança automática.
  monthlyFee       Decimal?  @db.Decimal(10, 2)
  /// Assinatura paga ATÉ esta data. É o campo que responde "venceu?":
  /// nulo = nunca cobrado; menor que hoje = vencido. Ao receber, empurra a data.
  paidUntil        DateTime?
  /// Quando o último pagamento foi registrado (auditoria do "recebi").
  lastPaymentAt    DateTime?
  /// Links úteis da loja: workflow do n8n, docs, painel. Formato:
  /// [{ "label": "Workflow", "url": "https://..." }]. Json porque a lista é
  /// livre e só o super admin lê — não vale uma tabela para isto.
  links            Json?
  /// Anotações do super admin sobre a loja. Nunca exposto ao dono.
  adminNotes       String?
  /// Etapas da implantação já concluídas, como lista de ids: ["workflow","negocio"].
  /// Só as que NÃO dá para deduzir sozinho — "WhatsApp conectado" vem do Evolution
  /// e "loja criada" vem da própria linha existir; marcar isso na mão seria
  /// um estado a mais para ficar mentindo.
  setupSteps       Json?

  settings      TenantSettings?
  customers     Customer[]
  leads         Lead[]
  quotes        Quote[]
  services      Service[]
  professionals Professional[]
  professionalServices ProfessionalService[]
  resources     Resource[]
  workingSchedules WorkingSchedule[]
  timeOffs      TimeOff[]
  appointments  Appointment[]
  appointmentServices AppointmentService[]
  calendarConnections CalendarConnection[]
  calendarSubscriptions CalendarSubscription[]
  commissions   Commission[]
  waitlistEntries WaitlistEntry[]
  payments      Payment[]
  expenses      Expense[]
  reminders     AppointmentReminder[]
  notifications Notification[]
  conversations Conversation[]
  messages      Message[]
  portfolioPhotos PortfolioPhoto[]
}

model TenantSettings {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappMain   String?
  whatsappAlerts String?
  // Nome da instância do Evolution API deste tenant (multi-tenant: cada empresa
  // tem seu próprio número/instância). Se vazio, cai pro slug do tenant.
  evolutionInstance String?
  /// Segredo que autentica as ferramentas do agente (/api/agent/*) DESTE tenant.
  /// Um por empresa: o de uma não abre a porta da outra. O AGENT_API_SECRET
  /// global continua existindo, mas só para /api/agent/tenant — a rota que
  /// descobre o dono de uma instância antes de se saber qual tenant é.
  agentApiSecret String?
  email          String?
  /// Razão social e CNPJ: aparecem em contrato/recibo, não no site.
  legalName      String?
  cnpj           String?
  city           String?
  baseAddress    String?
  serviceRadiusKm Int?
  businessHours  Json?
  instagram      String?
  facebook       String?
  googleMaps     String?
  /// Mensagem automática ao mover o card pra "Pós-atendimento" (pergunta a nota da experiência).
  postServiceMessage String?
  /// Link de avaliação (Google/Instagram) oferecido quando a nota do pós-atendimento é boa.
  reviewLink       String?
  logoUrl        String?
  faviconUrl     String?
  colorPrimary   String   @default("#2563EB")
  colorSecondary String   @default("#FBBF24")
  colorAccent    String   @default("#7C3AED")
  headline       String?
  subheadline    String?
  ctaText        String?
  siteMode       SiteMode @default(SITE_BUILDER)
  defaultSlotMinutes Int  @default(30)
  minAppointmentLeadMinutes Int @default(60)
  cancellationPolicy String?
}

model Customer {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  address      String?
  neighborhood String?
  imageConsent Boolean  @default(false)
  createdAt    DateTime @default(now())
  /// Arquivado = sai do painel sem apagar nada. Agendamentos/conversas continuam intactos.
  archivedAt   DateTime?
  appointments Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, archivedAt])
}

model Lead {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  source        LeadSource @default(WEBSITE)
  message       String?
  desiredDate   DateTime?
  neighborhood  String?
  desiredService String?
  status        LeadStatus @default(NEW)
  appointmentId String?
  createdAt     DateTime   @default(now())
  /// Arquivado = sai do painel sem apagar nada (ver Customer.archivedAt).
  archivedAt    DateTime?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
}

model Service {
  id                  String          @id @default(uuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  category            ServiceCategory @default(OTHER)
  description         String?
  durationMinutes     Int
  bufferBeforeMinutes Int             @default(0)
  bufferAfterMinutes  Int             @default(0)
  defaultPrice        Decimal         @db.Decimal(10, 2)
  status              ServiceStatus   @default(ACTIVE)
  locationMode        LocationMode    @default(SALON)
  imageUrl            String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  professionals   ProfessionalService[]
  appointments    AppointmentService[]
  waitlistEntries WaitlistEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Professional {
  id                    String             @id @default(uuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  phone                 String?
  email                 String?
  bio                   String?
  avatarUrl             String?
  color                 String             @default("#2563EB")
  status                ProfessionalStatus @default(ACTIVE)
  defaultCalendarId     String?
  defaultCommissionType CommissionType     @default(NONE)
  defaultCommissionValue Decimal?          @db.Decimal(10, 2)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  services            ProfessionalService[]
  workingSchedules    WorkingSchedule[]
  timeOffs            TimeOff[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  calendarConnections CalendarConnection[]
  commissions         Commission[]
  waitlistEntries     WaitlistEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model ProfessionalService {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId  String
  professional    Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  durationMinutes Int?
  price           Decimal?       @db.Decimal(10, 2)
  commissionType  CommissionType @default(NONE)
  commissionValue Decimal?       @db.Decimal(10, 2)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@unique([tenantId, professionalId, serviceId])
  @@index([tenantId])
  @@index([tenantId, serviceId])
}

model Resource {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  type         String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model WorkingSchedule {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Weekday
  startTime      String
  endTime        String
  breaks         Json?
  active         Boolean      @default(true)

  @@index([tenantId])
  @@index([tenantId, professionalId, dayOfWeek])
}

/// Tempo em que a cadeira NÃO pode ser vendida: folga, férias, almoço, ou um
/// compromisso que o profissional marcou direto no Google Calendar dele.
///
/// `professionalId` nulo bloqueia a casa inteira — a mesma convenção que
/// `Appointment.professionalId` nulo já usa para a "cadeira única".
model TimeOff {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  reason         String?
  /// Evento que originou o bloqueio quando ele veio do Google Calendar. É por
  /// ele que reencontramos a linha quando o evento é movido ou apagado lá.
  googleEventId  String?
  createdAt      DateTime      @default(now())

  @@unique([tenantId, googleEventId])
  @@index([tenantId])
  @@index([tenantId, professionalId, startAt])
  @@index([tenantId, startAt, endAt])
}

model Appointment {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id])
  professionalId        String?
  professional          Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  resourceId            String?
  resource              Resource?         @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  startAt               DateTime
  endAt                 DateTime
  status                AppointmentStatus @default(REQUESTED)
  total                 Decimal           @db.Decimal(10, 2) @default(0)
  paymentStatus         PaymentStatus     @default(PENDING)
  leadSource            LeadSource?
  notes                 String?
  googleCalendarEventId String?
  googleCalendarHtmlLink String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  services    AppointmentService[]
  payments    Payment[]
  expenses    Expense[]
  reminders   AppointmentReminder[]
  commissions Commission[]

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@index([tenantId, professionalId, startAt])
  @@index([tenantId, status])
}

model AppointmentService {
  id                    String          @id @default(uuid())
  tenantId              String
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId         String
  appointment           Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId             String
  service               Service         @relation(fields: [serviceId], references: [id])
  professionalId        String?
  professional          Professional?   @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  serviceNameSnapshot   String
  durationMinutes       Int
  price                 Decimal         @db.Decimal(10, 2)
  commissionType        CommissionType  @default(NONE)
  commissionValue       Decimal?        @db.Decimal(10, 2)

  commissions Commission[]

  @@index([tenantId])
  @@index([tenantId, appointmentId])
  @@index([tenantId, serviceId])
}

model CalendarConnection {
  id                    String                   @id @default(uuid())
  tenantId              String
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId        String?
  professional          Professional?            @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  provider              CalendarProvider         @default(GOOGLE)
  googleAccountEmail    String?
  calendarId            String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  scope                 String?
  status                CalendarConnectionStatus @default(ACTIVE)
  expiresAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  subscriptions CalendarSubscription[]

  @@index([tenantId])
  @@index([tenantId, professionalId])
}

model CalendarSubscription {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  channelId    String             @unique
  resourceId   String?
  syncToken    String?
  expiresAt    DateTime
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tenantId])
  @@index([tenantId, active, expiresAt])
}

model Commission {
  id                   String              @id @default(uuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId        String
  appointment          Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentServiceId String?
  appointmentService   AppointmentService? @relation(fields: [appointmentServiceId], references: [id], onDelete: SetNull)
  professionalId       String
  professional         Professional        @relation(fields: [professionalId], references: [id])
  amount               Decimal             @db.Decimal(10, 2)
  status               CommissionStatus    @default(PENDING)
  settledAt            DateTime?
  createdAt            DateTime            @default(now())

  @@index([tenantId])
  @@index([tenantId, professionalId, status])
  @@index([tenantId, appointmentId])
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  desiredDate    DateTime?
  earliestAt     DateTime?
  latestAt       DateTime?
  notes          String?
  status         WaitlistStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())

  @@index([tenantId])
  @@index([tenantId, status, desiredDate])
}

model Quote {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId     String?
  customerId String?
  items      Json
  total      Decimal  @db.Decimal(10, 2)
  validUntil DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model Payment {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(10, 2)
  kind          PaymentKind @default(APPOINTMENT)
  method        String?
  paidAt        DateTime?

  @@index([tenantId])
  @@index([tenantId, appointmentId])
}

model Expense {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  category      ExpenseCategory
  amount        Decimal          @db.Decimal(10, 2)
  description   String?
  date          DateTime         @default(now())

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, appointmentId])
}

model AppointmentReminder {
  id            String                  @id @default(uuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          AppointmentReminderType
  fireAt        DateTime
  status        ReminderStatus          @default(SCHEDULED)
  sentAt        DateTime?

  @@index([tenantId])
  @@index([status, fireAt])
  @@index([tenantId, appointmentId])
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  appointmentId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([tenantId, read])
  @@index([tenantId, appointmentId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum MessageSender {
  CONTACT // cliente
  BOT     // agente de IA
  AGENT   // atendente humano (equipe)
}

/** Etapa da conversa no funil (colunas do quadro em /admin/funil). */
enum ConversationStage {
  NOVO_LEAD      // legado: não é mais usado (toda conversa nova já nasce em IA_ATENDENDO)
  IA_ATENDENDO   // a Dinha está conduzindo — primeira coluna do funil
  SUPORTE_HUMANO // equipe assumiu (bot pausado)
  INTERESSADO    // quis, não fechou — a IA registrou o interesse pra equipe recuperar
  AGENDADO       // atendimento marcado
  POS_ATENDIMENTO      // acompanhamento pós-evento
}

/** Uma conversa de WhatsApp por telefone (inbox nativo do SaaS). Isolada por tenant (RLS). */
model Conversation {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone         String
  contactName   String?
  customerId    String?
  tags          String[] @default([]) // desligar-ia, atendimento-humano, cliente-vip, livres
  botPaused     Boolean  @default(false) // atendente assumiu → bot não responde
  stage         ConversationStage @default(IA_ATENDENDO) // coluna no funil (/admin/funil)
  notes         String?  // resumo do atendimento escrito pela IA (tool "notas")
  notesAt       DateTime?
  /// Resumo da conversa INTEIRA, gerado sob demanda (botão) ou ao a IA escalar
  /// pra humano. Campo separado do `notes` de propósito: `notes` é a última
  /// nota de evento e é sobrescrita a cada agendamento/lead/escalonamento — se
  /// dividissem o mesmo campo, um apagaria o outro.
  summary       String?
  summaryAt     DateTime?
  lastMessageAt DateTime @default(now())
  unread        Int      @default(0)
  createdAt     DateTime @default(now())
  /// Arquivado = sai do inbox e do funil. Mensagem nova do contato desarquiva sozinho.
  archivedAt    DateTime?

  messages      Message[]

  @@unique([tenantId, phone])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, archivedAt])
}

model Message {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  text           String
  createdAt      DateTime      @default(now())

  @@index([tenantId, conversationId, createdAt])
}

/**
 * Portfólio do site público — fotos de cortes, barbas e procedimentos.
 *
 * O binário NÃO fica aqui: a imagem vai pro Supabase Storage e a tabela guarda
 * só a URL pública, para o banco não crescer com foto.
 */
model PortfolioPhoto {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  /// Ordem de exibição no site; menor aparece primeiro.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, sortOrder])
}
