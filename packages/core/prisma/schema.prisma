// Barbearia AI — plataforma multi-tenant para agenda de serviços.
// Tudo isolado por tenantId; RLS aplicado via prisma/rls.sql.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  STAFF
}

enum SiteMode {
  SITE_BUILDER
  EXTERNAL_SITE
  CUSTOM_DOMAIN
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  GOOGLE
  INDICATION
  WHATSAPP
  WEBSITE
  PAID_ADS
  PARTNER
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum ServiceCategory {
  HAIR
  BEARD
  NAILS
  BROWS
  AESTHETICS
  TATTOO
  MASSAGE
  OTHER
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LocationMode {
  SALON
  CUSTOMER_ADDRESS
  ONLINE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  ARRIVED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELED
}

enum CommissionType {
  NONE
  FIXED
  PERCENTAGE
}

enum CommissionStatus {
  PENDING
  SETTLED
  CANCELED
}

enum CalendarProvider {
  GOOGLE
}

enum CalendarConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WaitlistStatus {
  ACTIVE
  CONTACTED
  BOOKED
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentKind {
  APPOINTMENT
  PRODUCT
  REFUND
}

enum ExpenseCategory {
  COMMISSION
  PRODUCTS
  RENT
  UTILITIES
  MARKETING
  SALARY
  OTHER
}

enum AppointmentReminderType {
  APPOINTMENT_24H
  APPOINTMENT_2H
  APPOINTMENT_30M
  FOLLOW_UP_24H
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELED
}

enum NotificationType {
  NEW_WHATSAPP_MESSAGE
  NEW_LEAD
  APPOINTMENT_CREATED
  APPOINTMENT_STARTING_SOON
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCEL_REQUESTED
  APPOINTMENT_NO_SHOW
  /// Avaliação pós-atendimento abaixo do corte: escalado pra equipe em vez do link público.
  POST_SERVICE_LOW_RATING
  PAYMENT_PENDING
  GOOGLE_CALENDAR_SYNC_FAILED
  INTEGRATION_ERROR
}

model Tenant {
  id           String   @id @default(uuid())
  clerkOrgId   String   @unique
  slug         String   @unique
  name         String
  customDomain String?  @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  settings      TenantSettings?
  customers     Customer[]
  leads         Lead[]
  quotes        Quote[]
  services      Service[]
  professionals Professional[]
  professionalServices ProfessionalService[]
  resources     Resource[]
  workingSchedules WorkingSchedule[]
  timeOffs      TimeOff[]
  appointments  Appointment[]
  appointmentServices AppointmentService[]
  calendarConnections CalendarConnection[]
  calendarSubscriptions CalendarSubscription[]
  commissions   Commission[]
  waitlistEntries WaitlistEntry[]
  payments      Payment[]
  expenses      Expense[]
  reminders     AppointmentReminder[]
  notifications Notification[]
  conversations Conversation[]
  messages      Message[]
  portfolioPhotos PortfolioPhoto[]
}

model TenantSettings {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappMain   String?
  whatsappAlerts String?
  // Nome da instância do Evolution API deste tenant (multi-tenant: cada empresa
  // tem seu próprio número/instância). Se vazio, cai pro slug do tenant.
  evolutionInstance String?
  /// Segredo que autentica as ferramentas do agente (/api/agent/*) DESTE tenant.
  /// Um por empresa: o de uma não abre a porta da outra. O AGENT_API_SECRET
  /// global continua existindo, mas só para /api/agent/tenant — a rota que
  /// descobre o dono de uma instância antes de se saber qual tenant é.
  agentApiSecret String?
  email          String?
  /// Razão social e CNPJ: aparecem em contrato/recibo, não no site.
  legalName      String?
  cnpj           String?
  city           String?
  baseAddress    String?
  serviceRadiusKm Int?
  businessHours  Json?
  instagram      String?
  facebook       String?
  googleMaps     String?
  /// Mensagem automática ao mover o card pra "Pós-atendimento" (pergunta a nota da experiência).
  postServiceMessage String?
  /// Link de avaliação (Google/Instagram) oferecido quando a nota do pós-atendimento é boa.
  reviewLink       String?
  logoUrl        String?
  faviconUrl     String?
  colorPrimary   String   @default("#2563EB")
  colorSecondary String   @default("#FBBF24")
  colorAccent    String   @default("#7C3AED")
  headline       String?
  subheadline    String?
  ctaText        String?
  siteMode       SiteMode @default(SITE_BUILDER)
  defaultSlotMinutes Int  @default(30)
  minAppointmentLeadMinutes Int @default(60)
  cancellationPolicy String?
}

model Customer {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  address      String?
  neighborhood String?
  imageConsent Boolean  @default(false)
  createdAt    DateTime @default(now())
  /// Arquivado = sai do painel sem apagar nada. Agendamentos/conversas continuam intactos.
  archivedAt   DateTime?
  appointments Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, archivedAt])
}

model Lead {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  source        LeadSource @default(WEBSITE)
  message       String?
  desiredDate   DateTime?
  neighborhood  String?
  desiredService String?
  status        LeadStatus @default(NEW)
  appointmentId String?
  createdAt     DateTime   @default(now())
  /// Arquivado = sai do painel sem apagar nada (ver Customer.archivedAt).
  archivedAt    DateTime?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
}

model Service {
  id                  String          @id @default(uuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  category            ServiceCategory @default(OTHER)
  description         String?
  durationMinutes     Int
  bufferBeforeMinutes Int             @default(0)
  bufferAfterMinutes  Int             @default(0)
  defaultPrice        Decimal         @db.Decimal(10, 2)
  status              ServiceStatus   @default(ACTIVE)
  locationMode        LocationMode    @default(SALON)
  imageUrl            String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  professionals   ProfessionalService[]
  appointments    AppointmentService[]
  waitlistEntries WaitlistEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Professional {
  id                    String             @id @default(uuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  phone                 String?
  email                 String?
  bio                   String?
  avatarUrl             String?
  color                 String             @default("#2563EB")
  status                ProfessionalStatus @default(ACTIVE)
  defaultCalendarId     String?
  defaultCommissionType CommissionType     @default(NONE)
  defaultCommissionValue Decimal?          @db.Decimal(10, 2)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  services            ProfessionalService[]
  workingSchedules    WorkingSchedule[]
  timeOffs            TimeOff[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  calendarConnections CalendarConnection[]
  commissions         Commission[]
  waitlistEntries     WaitlistEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model ProfessionalService {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId  String
  professional    Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  durationMinutes Int?
  price           Decimal?       @db.Decimal(10, 2)
  commissionType  CommissionType @default(NONE)
  commissionValue Decimal?       @db.Decimal(10, 2)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@unique([tenantId, professionalId, serviceId])
  @@index([tenantId])
  @@index([tenantId, serviceId])
}

model Resource {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  type         String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model WorkingSchedule {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Weekday
  startTime      String
  endTime        String
  breaks         Json?
  active         Boolean      @default(true)

  @@index([tenantId])
  @@index([tenantId, professionalId, dayOfWeek])
}

model TimeOff {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([tenantId])
  @@index([tenantId, professionalId, startAt])
}

model Appointment {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id])
  professionalId        String?
  professional          Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  resourceId            String?
  resource              Resource?         @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  startAt               DateTime
  endAt                 DateTime
  status                AppointmentStatus @default(REQUESTED)
  total                 Decimal           @db.Decimal(10, 2) @default(0)
  paymentStatus         PaymentStatus     @default(PENDING)
  leadSource            LeadSource?
  notes                 String?
  googleCalendarEventId String?
  googleCalendarHtmlLink String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  services    AppointmentService[]
  payments    Payment[]
  expenses    Expense[]
  reminders   AppointmentReminder[]
  commissions Commission[]

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@index([tenantId, professionalId, startAt])
  @@index([tenantId, status])
}

model AppointmentService {
  id                    String          @id @default(uuid())
  tenantId              String
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId         String
  appointment           Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId             String
  service               Service         @relation(fields: [serviceId], references: [id])
  professionalId        String?
  professional          Professional?   @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  serviceNameSnapshot   String
  durationMinutes       Int
  price                 Decimal         @db.Decimal(10, 2)
  commissionType        CommissionType  @default(NONE)
  commissionValue       Decimal?        @db.Decimal(10, 2)

  commissions Commission[]

  @@index([tenantId])
  @@index([tenantId, appointmentId])
  @@index([tenantId, serviceId])
}

model CalendarConnection {
  id                    String                   @id @default(uuid())
  tenantId              String
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId        String?
  professional          Professional?            @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  provider              CalendarProvider         @default(GOOGLE)
  googleAccountEmail    String?
  calendarId            String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  scope                 String?
  status                CalendarConnectionStatus @default(ACTIVE)
  expiresAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  subscriptions CalendarSubscription[]

  @@index([tenantId])
  @@index([tenantId, professionalId])
}

model CalendarSubscription {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  channelId    String             @unique
  resourceId   String?
  syncToken    String?
  expiresAt    DateTime
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tenantId])
  @@index([tenantId, active, expiresAt])
}

model Commission {
  id                   String              @id @default(uuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId        String
  appointment          Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentServiceId String?
  appointmentService   AppointmentService? @relation(fields: [appointmentServiceId], references: [id], onDelete: SetNull)
  professionalId       String
  professional         Professional        @relation(fields: [professionalId], references: [id])
  amount               Decimal             @db.Decimal(10, 2)
  status               CommissionStatus    @default(PENDING)
  settledAt            DateTime?
  createdAt            DateTime            @default(now())

  @@index([tenantId])
  @@index([tenantId, professionalId, status])
  @@index([tenantId, appointmentId])
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  desiredDate    DateTime?
  earliestAt     DateTime?
  latestAt       DateTime?
  notes          String?
  status         WaitlistStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())

  @@index([tenantId])
  @@index([tenantId, status, desiredDate])
}

model Quote {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId     String?
  customerId String?
  items      Json
  total      Decimal  @db.Decimal(10, 2)
  validUntil DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model Payment {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(10, 2)
  kind          PaymentKind @default(APPOINTMENT)
  method        String?
  paidAt        DateTime?

  @@index([tenantId])
  @@index([tenantId, appointmentId])
}

model Expense {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  category      ExpenseCategory
  amount        Decimal          @db.Decimal(10, 2)
  description   String?
  date          DateTime         @default(now())

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, appointmentId])
}

model AppointmentReminder {
  id            String                  @id @default(uuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          AppointmentReminderType
  fireAt        DateTime
  status        ReminderStatus          @default(SCHEDULED)
  sentAt        DateTime?

  @@index([tenantId])
  @@index([status, fireAt])
  @@index([tenantId, appointmentId])
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  appointmentId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([tenantId, read])
  @@index([tenantId, appointmentId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum MessageSender {
  CONTACT // cliente
  BOT     // agente de IA
  AGENT   // atendente humano (equipe)
}

/** Etapa da conversa no funil (colunas do quadro em /admin/funil). */
enum ConversationStage {
  NOVO_LEAD      // legado: não é mais usado (toda conversa nova já nasce em IA_ATENDENDO)
  IA_ATENDENDO   // a Dinha está conduzindo — primeira coluna do funil
  SUPORTE_HUMANO // equipe assumiu (bot pausado)
  AGENDADO       // atendimento marcado
  POS_ATENDIMENTO      // acompanhamento pós-evento
}

/** Uma conversa de WhatsApp por telefone (inbox nativo do SaaS). Isolada por tenant (RLS). */
model Conversation {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone         String
  contactName   String?
  customerId    String?
  tags          String[] @default([]) // desligar-ia, atendimento-humano, cliente-vip, livres
  botPaused     Boolean  @default(false) // atendente assumiu → bot não responde
  stage         ConversationStage @default(IA_ATENDENDO) // coluna no funil (/admin/funil)
  notes         String?  // resumo do atendimento escrito pela IA (tool "notas")
  notesAt       DateTime?
  /// Resumo da conversa INTEIRA, gerado sob demanda (botão) ou ao a IA escalar
  /// pra humano. Campo separado do `notes` de propósito: `notes` é a última
  /// nota de evento e é sobrescrita a cada agendamento/lead/escalonamento — se
  /// dividissem o mesmo campo, um apagaria o outro.
  summary       String?
  summaryAt     DateTime?
  lastMessageAt DateTime @default(now())
  unread        Int      @default(0)
  createdAt     DateTime @default(now())
  /// Arquivado = sai do inbox e do funil. Mensagem nova do contato desarquiva sozinho.
  archivedAt    DateTime?

  messages      Message[]

  @@unique([tenantId, phone])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, archivedAt])
}

model Message {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  text           String
  createdAt      DateTime      @default(now())

  @@index([tenantId, conversationId, createdAt])
}

/**
 * Portfólio do site público — fotos de cortes, barbas e procedimentos.
 *
 * O binário NÃO fica aqui: a imagem vai pro Supabase Storage e a tabela guarda
 * só a URL pública, para o banco não crescer com foto.
 */
model PortfolioPhoto {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  /// Ordem de exibição no site; menor aparece primeiro.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, sortOrder])
}
