{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    "noEmit": true,
    "incremental": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@barbearia-ai/core": ["../../packages/core/src/index.ts"],
      "@barbearia-ai/core/services": ["../../packages/core/src/services/index.ts"],
      "@barbearia-ai/core/schemas": ["../../packages/core/src/schemas/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "src", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"]
}
